# Copy to .env and replace the placeholder with the project's database password.
# Existing PostgreSQL container: postgres (PostgreSQL 16).
DATABASE_URL=postgresql://it_service_desk:REPLACE_WITH_PROJECT_PASSWORD@127.0.0.1:5432/it_service_desk
# Optional, required only by `bun run test:integration`. Must be a separate database ending in `_test`.
TEST_DATABASE_URL=postgresql://test_role:REPLACE_WITH_TEST_PASSWORD@127.0.0.1:5432/it_service_desk_test
# API listens on loopback only.
PORT=3000

# --- Notifikasi Telegram (opsional) ---
# Kosongkan keduanya untuk menonaktifkan notifikasi. Notifikasi tiket baru dikirim ke TELEGRAM_CHAT_ID
# (bisa lebih dari satu, pisahkan dengan koma). Dapatkan chat id dari @userinfobot / @RawDataBot.
TELEGRAM_BOT_TOKEN=
# Chat id grup. Untuk grup forum, tambahkan juga id topic (message thread) di bawah.
TELEGRAM_CHAT_ID=
# Opsional: id topic pada grup forum (angka terakhir dari "Copy Link" topic, mis. t.me/c/1234567890123/45 -> 45).
TELEGRAM_THREAD_ID=
# Basis URL publik aplikasi, dipakai untuk tautan "buka tiket" di pesan Telegram.
APP_URL=
