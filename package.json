{
  "name": "it-service-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "bun run dev:api & bun run dev:web",
    "dev:api": "bun --watch src/server/index.ts",
    "dev:web": "vite --host",
    "check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test tests/*.test.ts",
    "test:integration": "bun scripts/test-integration.ts",
    "build:web": "vite build",
    "build:server": "bun build --target=bun --outdir=dist/server src/server/index.ts",
    "build": "vite build && bun build --target=bun --outdir=dist/server src/server/index.ts",
    "start": "bun dist/server/index.js"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/bun": "1.4.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.0"
  },
  "dependencies": {
    "svelte": "5.57.0"
  }
}
